{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-destructive-commands.sh",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format-on-save.sh",
        "timeout": 15,
        "failClosed": false
      }
    ]
  }
}
