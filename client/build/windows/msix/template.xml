<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="xvpn-client"
        Arguments=""
        InstallLocation="C:\Program Files\rootkit-lab\XVPN">
    </Installer>
    <PackageInformation
        PackageName="XVPN"
        PackageDisplayName="XVPN"
        PublisherName="CN=rootkit-lab"
        PublisherDisplayName="rootkit-lab"
        Version="0.1.0.0"
        PackageDescription="Cliente desktop da VPN privada XVPN">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.rootkitlab.xvpn"
                Description="Cliente desktop da VPN privada XVPN"
                DisplayName="XVPN"
                ExecutableName="xvpn-client"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>XVPN</DisplayName>
            <PublisherDisplayName>rootkit-lab</PublisherDisplayName>
            <Description>Cliente desktop da VPN privada XVPN</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="xvpn-client.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
